OPENAI_API_KEY=sk-your-key-here
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
DATABASE_URL=sqlite:///./data/idp.db
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=25
MAX_DOCUMENT_TOKENS=200000

# Durable processing (start Redis and a worker separately)
REDIS_URL=redis://localhost:6379/0
WORKER_CONCURRENCY=4
WORKER_METRICS_PORT=8001
JOB_MAX_ATTEMPTS=3
JOB_LEASE_SECONDS=180
RETRY_BASE_SECONDS=5

# Inference: these models must support Chat Completions JSON mode/strict JSON Schema/max_tokens.
# Empty routes use OPENAI_CHAT_MODEL; set COMPLEX_MODEL to compare a second model.
ANSWER_MODEL=
COMPLEX_MODEL=
LLM_CONCURRENCY=4
LLM_TIMEOUT_SECONDS=60
LLM_INPUT_TOKENS=12000
LLM_OUTPUT_TOKENS=1000
CACHE_TTL_SECONDS=3600
EMBEDDING_BATCH_SIZE=64
EMBEDDING_BATCH_TOKENS=60000
CHUNK_TOKENS=400
CHUNK_OVERLAP_TOKENS=60
RETRIEVAL_CANDIDATES=30
RERANKER=llm
RAG_CONTEXT_TOKENS=6000

# Optional OTLP HTTP base URL (without /v1/traces).
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# USD per million tokens. Verify rates for your deployment; unknown model costs return null.
MODEL_PRICES={"gpt-4o-mini":{"input":0.15,"cached_input":0.075,"output":0.6},"text-embedding-3-small":{"input":0.02}}
